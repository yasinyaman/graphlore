{
  "name": "graphlore",
  "displayName": "graphlore",
  "version": "0.5.1",
  "description": "Navigate a Graphify codebase knowledge graph joined to real source spans: an MCP server plus an exploration skill.",
  "author": {
    "name": "yasinyaman",
    "url": "https://github.com/yasinyaman"
  },
  "homepage": "https://github.com/yasinyaman/graphlore",
  "repository": "https://github.com/yasinyaman/graphlore",
  "license": "MIT",
  "keywords": ["mcp", "graphify", "knowledge-graph", "codebase", "code-search"],
  "skills": ["./.claude/skills/"],
  "mcpServers": {
    "graphlore": {
      "command": "uvx",
      "args": [
        "--from",
        "graphlore[graphify,treesitter,semble] @ ${CLAUDE_PLUGIN_ROOT}",
        "graphlore"
      ],
      "env": {
        "GRAPHLORE_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}",
        "GRAPHLORE_TOOLSET": "full"
      }
    }
  }
}
