{
  "name": "graphlore",
  "displayName": "graphlore",
  "version": "0.8.0",
  "description": "Let Claude navigate a codebase through its knowledge graph, for questions that need the whole repository: an MCP server (semantic locate, impact analysis, token-budgeted subgraphs, exact source spans) plus an exploration skill. The graph is built by its own Rust engine, in 14 languages.",
  "author": {
    "name": "yasinyaman",
    "url": "https://github.com/yasinyaman"
  },
  "homepage": "https://github.com/yasinyaman/graphlore",
  "repository": "https://github.com/yasinyaman/graphlore",
  "license": "MIT",
  "keywords": ["mcp", "mcp-server", "graphify", "knowledge-graph", "codebase", "code-search", "code-navigation", "impact-analysis", "semantic-search"],
  "skills": ["./skills/"],
  "mcpServers": {
    "graphlore": {
      "command": "uvx",
      "args": [
        "--from",
        "graphlore[treesitter,embed] @ ${CLAUDE_PLUGIN_ROOT}",
        "graphlore"
      ],
      "env": {
        "GRAPHLORE_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}",
        "GRAPHLORE_TOOLSET": "full"
      }
    }
  }
}
